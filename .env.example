DB_HOST=127.0.0.1
DB_PORT=3306
# Local: use root (or your Mac MySQL user) + database "hcc"
# Production Hostinger: u951296915_hcc / u951296915_hccafrica (see .env.production)
DB_USER=root
DB_PASSWORD=
DB_NAME=hcc
PORT=5001
NODE_ENV=development
API_BASE_URL=http://localhost:5001
CORS_ORIGINS=http://localhost:3001,https://hccafrica.com,https://www.hccafrica.com,https://management.hccafrica.com,http://management.hccafrica.com
SCHEMA_INCLUDE_DATA=true
RUN_SCHEMA_INIT=false

# Hostinger Mail API
HOSTINGER_MAIL_API_TOKEN=
HOSTINGER_MAIL_ADDRESS=info@support.hccafrica.com
HOSTINGER_MAIL_PASSWORD=

# Used in welcome / assignment emails (sign-in button)
FRONTEND_URL=http://localhost:3001
